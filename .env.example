# Supabase - Copie de Settings → API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key - NUNCA commite isso!
# Use apenas em variáveis privadas (não NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave para proteger o endpoint /api/sync (opcional)
# Se definida, o frontend envia via header x-sync-key
SYNC_API_KEY=

# Segurança para cron jobs (opcional)
CRON_SECRET=seu-secret-aleatorio-aqui

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
